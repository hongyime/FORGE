{
  "version": "1.0",
  "description": "Module 2-I secret detection patterns for domain-keyed repository scanning.",
  "patterns": [
    {
      "name": "aws_access_key",
      "regex": "AKIA[0-9A-Z]{16}",
      "confidence": "high"
    },
    {
      "name": "aws_secret_key",
      "regex": "(?i)aws[_\\-]?secret[_\\-]?access[_\\-]?key[\"']?\\s*[:=]\\s*[\"']?([A-Za-z0-9/+]{40})",
      "confidence": "high",
      "group": 1
    },
    {
      "name": "private_key_pem",
      "regex": "-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----",
      "confidence": "high"
    },
    {
      "name": "github_pat_classic",
      "regex": "ghp_[A-Za-z0-9]{36}",
      "confidence": "high"
    },
    {
      "name": "github_pat_fine_grained",
      "regex": "github_pat_[A-Za-z0-9_]{82}",
      "confidence": "high"
    },
    {
      "name": "generic_api_key",
      "regex": "(?i)(api[_\\-]?key|apikey)[\"']?\\s*[:=]\\s*[\"']?([A-Za-z0-9\\-_]{20,})",
      "confidence": "medium",
      "group": 2
    },
    {
      "name": "bearer_token",
      "regex": "(?i)bearer\\s+([A-Za-z0-9\\-._~+/]{20,})",
      "confidence": "medium",
      "group": 1
    },
    {
      "name": "connection_string",
      "regex": "(?i)(mysql|postgres|mongodb|redis|mssql):\\/\\/[^\\s\"'<>]+",
      "confidence": "high"
    },
    {
      "name": "smtp_password",
      "regex": "(?i)smtp[_\\-]?pass(word)?[\"']?\\s*[:=]\\s*[\"']?([^\\s\"']{8,})",
      "confidence": "medium",
      "group": 2
    },
    {
      "name": "slack_token",
      "regex": "xox[baprs]-[0-9A-Za-z\\-]{10,48}",
      "confidence": "high"
    },
    {
      "name": "jwt_token",
      "regex": "eyJ[A-Za-z0-9_\\-]{10,}\\.eyJ[A-Za-z0-9_\\-]{10,}\\.[A-Za-z0-9_\\-]{10,}",
      "confidence": "medium"
    },
    {
      "name": "google_api_key",
      "regex": "AIza[0-9A-Za-z\\-_]{35}",
      "confidence": "high"
    },
    {
      "name": "openai_project_api_key",
      "regex": "sk-proj-[A-Za-z0-9_\\-]{20,}",
      "confidence": "high"
    },
    {
      "name": "openai_legacy_api_key",
      "regex": "sk-[A-Za-z0-9]{48}",
      "confidence": "high"
    },
    {
      "name": "anthropic_api_key",
      "regex": "sk-ant-api[0-9]{2}-[A-Za-z0-9_\\-]{20,}",
      "confidence": "high"
    },
    {
      "name": "huggingface_token",
      "regex": "hf_[A-Za-z0-9]{20,}",
      "confidence": "high"
    },
    {
      "name": "discord_bot_token",
      "regex": "[A-Za-z0-9_\\-]{24}\\.[A-Za-z0-9_\\-]{6}\\.[A-Za-z0-9_\\-]{27,38}",
      "confidence": "high"
    },
    {
      "name": "telegram_bot_token",
      "regex": "[0-9]{8,12}:[A-Za-z0-9_\\-]{35}",
      "confidence": "high"
    },
    {
      "name": "notion_integration_token",
      "regex": "ntn_[A-Za-z0-9_\\-]{20,}",
      "confidence": "high"
    },
    {
      "name": "notion_legacy_secret_token",
      "regex": "(?i)(?:NOTION(?:_API)?_TOKEN|NOTION_SECRET|notion[_\\-]?secret)[\"']?\\s*[:=]\\s*[\"']?(secret_[A-Za-z0-9]{20,})",
      "confidence": "high",
      "group": 1
    },
    {
      "name": "datadog_api_key",
      "regex": "(?i)(?:DD_API_KEY|DATADOG_API_KEY|datadog[_\\-]?api[_\\-]?key)[\"']?\\s*[:=]\\s*[\"']?([0-9a-f]{32})",
      "confidence": "high",
      "group": 1
    },
    {
      "name": "cloudflare_api_token",
      "regex": "(?i)(?:CLOUDFLARE_API_TOKEN|CF_API_TOKEN|cloudflare[_\\-]?api[_\\-]?token)[\"']?\\s*[:=]\\s*[\"']?([A-Za-z0-9_\\-]{20,})",
      "confidence": "high",
      "group": 1
    },
    {
      "name": "vercel_access_token",
      "regex": "(?i)(?:VERCEL_TOKEN|VERCEL_ACCESS_TOKEN|vercel[_\\-]?(?:access[_\\-]?)?token)[\"']?\\s*[:=]\\s*[\"']?([A-Za-z0-9_\\-]{20,})",
      "confidence": "high",
      "group": 1
    },
    {
      "name": "netlify_personal_access_token",
      "regex": "(?i)(?:NETLIFY_AUTH_TOKEN|NETLIFY_ACCESS_TOKEN|NETLIFY_TOKEN|netlify[_\\-]?(?:auth|access)?[_\\-]?token)[\"']?\\s*[:=]\\s*[\"']?([A-Za-z0-9_\\-.]{20,})",
      "confidence": "high",
      "group": 1
    },
    {
      "name": "posthog_personal_api_key",
      "regex": "phx_[A-Za-z0-9_\\-]{20,}",
      "confidence": "high"
    },
    {
      "name": "sentry_auth_token",
      "regex": "(?i)(?:SENTRY_AUTH_TOKEN|SENTRY_API_TOKEN|sentry[_\\-]?(?:auth[_\\-]?)?token)[\"']?\\s*[:=]\\s*[\"']?([A-Za-z0-9_\\-]{20,})",
      "confidence": "high",
      "group": 1
    }
  ]
}
