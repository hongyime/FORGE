            {"field": "idor_finding_count", "omitted_default": 0},
            {"field": "has_validated_creds", "omitted_default": false},
            {"field": "mermaid_snippet", "omitted_default": null}
          ]
        },
        {
          "id": "report-missing-required-fields",
          "description": "Required fields for AttackGraphReportContext",
          "cases": [
            {"omit": "engagement_id", "accepted": false},
            {"omit": "critical_path_summary", "accepted": false},
            {"omit": "critical_path_weight", "accepted": false},
            {"omit": "total_critical_nodes", "accepted": false},
            {"omit": "total_high_nodes", "accepted": false},
            {"omit": "top_exploits", "accepted": false}
          ]
        },
        {
          "id": "report-unicode-in-summary",
          "description": "Unicode strings in critical_path_summary and top_exploits are passed through",
          "input": {
            "engagement_id": 2,
            "critical_path_summary": ["エントリポイント", "10.0.0.1", "侵害完了"],
            "critical_path_weight": 100.0,
