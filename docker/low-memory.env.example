# FORGE low-memory Docker profile.
#
# Use with:
#   docker compose --env-file docker/low-memory.env.example -f docker/docker-compose.yml --profile autostart config
#
# These values keep the core production services tightly capped and give the
# guarded autostart runner enough headroom to pass its own preflight.
# before operator-provided secrets are added through another env source.
FORGE_CONTAINER_CPUS=0.25
FORGE_CONTAINER_MEM_LIMIT=256m
FORGE_POSTGRES_CPUS=0.20
FORGE_POSTGRES_MEM_LIMIT=256m
FORGE_REDIS_CPUS=0.10
FORGE_REDIS_MEM_LIMIT=64m
FORGE_AUTOSTART_CPUS=0.25
FORGE_AUTOSTART_MEM_LIMIT=1536m
FORGE_AUTOSTART_MIN_FREE_MEMORY_MB=128
