# ─────────────────────────────────────────────────────────────────
#  FORGE Toolkit — Environment configuration
# ─────────────────────────────────────────────────────────────────
#  Copy this file to `.env` and fill in what you need. Every value
#  is optional; sensible defaults ship in code.
#
#  The recommended workflow (all env vars empty except the KEY ones):
#     forge kill-chain <seed> --engagement N
#
#  Any variable left empty enables auto-discovery / free-tier mode.
# ─────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════
#  Section 1: Operator identity + data location
# ═════════════════════════════════════════════════════════════════

# Callsign recorded in every audit_log entry (default: prawn)
FORGE_OPERATOR=prawn

# Absolute path for cache data, logs, engagement DBs
# (leave empty for repo-relative .forge_data/)
FORGE_DATA_DIR=


# ═════════════════════════════════════════════════════════════════
#  Section 2: Operational posture
# ═════════════════════════════════════════════════════════════════

# 1 = skip Tor daemon startup (10x speedup on offline commands).
# All .bat files set this to 1 automatically.
FORGE_NO_TOR=1

# 1 = disables Phase 3 payload gen + Phase 5 post-ex (AV-safe posture).
# Leave 0 for OSINT-only ops.
FORGE_SAFE_MODE=0

# Optional rules-of-engagement / written-authorization reference.
# Recorded in kill-chain live-execution metadata and audit rows.
# Required for ANY live (non-dry-run) kill-chain launch (attack-mode is now ON by default).
# Set this to your permanent ROE reference for personal use, or a per-engagement ID for client work.
FORGE_ROE_ID=ROE-BRYAN-PERMANENT-2026

# Path to a ROE/scope JSON manifest declaring authorized domains, URL prefixes,
# IP ranges, and exact non-network seeds. Required for ANY live kill-chain.
# For personal use: point at the included permissive manifest.
# For client engagements: write a narrow manifest per-engagement.
FORGE_SCOPE_MANIFEST=manifests/default.json

# 1 = require FORGE_SCOPE_MANIFEST for every non-dry-run kill-chain launch,
# including passive live probing.
FORGE_REQUIRE_SCOPE_MANIFEST=0

# 1 = process-wide airgap. Kills every outbound socket.
FORGE_OFFLINE_STRICT=0

# Auto-cascades LLM providers for the Phase 6 report:
#   kiro_cli -> claude_code -> openai_compatible -> codex_cli
#   -> gemini_cli -> bedrock_anthropic -> template
FORGE_LLM_PROVIDER=auto

# `forge doctor` reports static LLM provider signals by default. Set this to 1
# or pass `--live-provider-probes` only when bounded local/SaaS model-list
# probing is intentionally allowed.
FORGE_DOCTOR_LIVE_PROVIDER_PROBES=0

# Deployment posture read by `forge doctor`.
# Keep `local` for workstation use. Set `production` before self-host/shared
# exposure and resolve the Deployment Hardening doctor row.
FORGE_DEPLOYMENT_PROFILE=local
FORGE_ENV=local

# Optional theprawnhunter -> Forge scheduled target import bridge. Doctor reports
# readiness without reading the .env secret value or probing the API by default.
FORGE_TPH_TARGET_IMPORT_ENABLED=0
FORGE_TPH_TARGET_IMPORT_API_URL=http://127.0.0.1:8011/monitor/targets/export
FORGE_TPH_ENV_PATH=X:\01 REPOSITORIES\theprawnhunter\.env
FORGE_TPH_COMPOSE_PATH=X:\01 REPOSITORIES\theprawnhunter\docker-compose.yml
FORGE_TPH_TARGET_IMPORT_TASK_NAME=\FORGE Import theprawnhunter Targets

# Optional data-only connector catalog extension directories. JSON manifests
# use schema forge.connector.plugin.v1 and are never executed as code. The
# default local directory is FORGE_DATA_DIR/connector_plugins.
FORGE_CONNECTOR_PLUGIN_DIRS=

# HTTPS URL users should reach in production, or the reverse proxy/load balancer
# name that terminates TLS. Values are not printed by doctor.
FORGE_PUBLIC_BASE_URL=
FORGE_TLS_TERMINATED_BY=


# ═════════════════════════════════════════════════════════════════
#  Section 3: Encryption keys (age)
# ═════════════════════════════════════════════════════════════════

# Age secret key for at-rest credential encryption. Auto-generated
# on first run by bootstrap.py if empty.
FORGE_ENGAGEMENT_KEY=

# Public key for the above (Recipient half of the age keypair)
FORGE_ENGAGEMENT_AGE_PUBKEY=

# Web UI/API are disabled by default. For production self-hosting, set
# FORGE_WEB_ENABLED=1, keep FORGE_WEB_AUTH=jwt, set a >=32 char random secret,
# require a scope manifest, and run `forge doctor --json`.
FORGE_WEB_ENABLED=0
FORGE_WEB_HOST=127.0.0.1
FORGE_WEB_PORT=8080
FORGE_WEB_AUTH=jwt
FORGE_WEB_SECRET_KEY=
FORGE_WEB_BOOTSTRAP_TOKEN=
FORGE_SECURITY_HEADERS_DISABLE=0
FORGE_SECURITY_HSTS_SECONDS=31536000

# Distributed workflow state is optional. If enabled, doctor expects Redis.
FORGE_DISTRIBUTED_ENABLED=0
FORGE_REDIS_URL=
FORGE_POSTGRES_PASSWORD=
FORGE_STATE_DB_URL=
FORGE_AUDIT_DB_URL=

# Optional append-only audit manifest bundle storage for production evidence.
# Use an absolute mounted path or file:// URI and a customer/workspace scope.
FORGE_AUDIT_BUNDLE_REMOTE_URI=
FORGE_AUDIT_BUNDLE_REMOTE_SCOPE=


# ═════════════════════════════════════════════════════════════════
#  Section 4: OSINT credentials (all optional / free-tier fallbacks)
# ═════════════════════════════════════════════════════════════════

# GitHub burn-account PAT for keyscan (raises rate limit from 30/min
# anonymous to 5000/hour authenticated). Highly recommended.
FORGE_GITHUB_TOKEN=

# Optional Shodan API key for passive host/domain enrichment.
FORGE_SHODAN_API_KEY=

# Slow-and-steady Shodan pacing. These respect Shodan rate limits; they do not
# bypass provider controls.
FORGE_SHODAN_REQUEST_DELAY_SECONDS=1.0
FORGE_SHODAN_RATE_LIMIT_BACKOFF_SECONDS=30.0
FORGE_SHODAN_MAX_RETRY_AFTER_SECONDS=90.0
FORGE_SHODAN_RATE_LIMIT_RETRIES=1

# Slow-and-steady crt.sh CT-log lookup pacing for subdomain enumeration.
FORGE_CRTSH_REQUEST_DELAY_SECONDS=1.0
FORGE_CRTSH_RATE_LIMIT_BACKOFF_SECONDS=60.0
FORGE_CRTSH_MAX_RETRY_AFTER_SECONDS=300.0
FORGE_CRTSH_RATE_LIMIT_RETRIES=1

# Slow-and-steady URLScan pacing. URLScan has a small anonymous quota, so these
# defaults intentionally trade speed for stable recursive discovery.
FORGE_URLSCAN_REQUEST_DELAY_SECONDS=1.0
FORGE_URLSCAN_RATE_LIMIT_BACKOFF_SECONDS=60.0
FORGE_URLSCAN_MAX_RETRY_AFTER_SECONDS=300.0
FORGE_URLSCAN_RATE_LIMIT_RETRIES=1

# Slow-and-steady Wayback CDX pacing. This backs the historical URL fan-out
# that feeds old pages, static files, and artifact links back into recursion.
FORGE_WAYBACK_REQUEST_DELAY_SECONDS=1.0
FORGE_WAYBACK_RATE_LIMIT_BACKOFF_SECONDS=60.0
FORGE_WAYBACK_MAX_RETRY_AFTER_SECONDS=300.0
FORGE_WAYBACK_RATE_LIMIT_RETRIES=1

# Common Crawl CDXJ passive URL discovery. Enabled by default outside tests and
# kept intentionally small so we do not overload the public index server.
FORGE_COMMONCRAWL_ENABLED=1
FORGE_COMMONCRAWL_INDEX_LIMIT=2
FORGE_COMMONCRAWL_RESULTS_PER_INDEX=500
FORGE_COMMONCRAWL_REQUEST_DELAY_SECONDS=1.0
FORGE_COMMONCRAWL_RATE_LIMIT_BACKOFF_SECONDS=60.0
FORGE_COMMONCRAWL_MAX_RETRY_AFTER_SECONDS=300.0
FORGE_COMMONCRAWL_RATE_LIMIT_RETRIES=1

# Optional same-provider subprocess launch staggering. Keep at 0 unless you
# explicitly raise FORGE_<PROVIDER>_MAX_WORKERS above 1 and need slower starts.
# Provider-specific overrides use names like FORGE_SHODAN_BATCH_STAGGER_SECONDS.
FORGE_PROVIDER_BATCH_STAGGER_SECONDS=0.0

# Optional delay before each in-scope HTML/rendered-page fetch. Use this to
# slow target-side recursive page/static discovery on real engagements. 429
# backoff/cooldown is remembered per target host inside the current process.
FORGE_WEB_FETCH_REQUEST_DELAY_SECONDS=0.0
FORGE_WEB_FETCH_RATE_LIMIT_BACKOFF_SECONDS=30.0
FORGE_WEB_FETCH_MAX_RETRY_AFTER_SECONDS=300.0
FORGE_WEB_FETCH_RATE_LIMIT_RETRIES=1

# Active port-scan pacing. These are only used when live probing is enabled.
FORGE_PORT_SCAN_HOST_DELAY_SECONDS=0.0
FORGE_PORT_SCAN_PORT_DELAY_SECONDS=0.0
FORGE_PORT_SCAN_PORT_CONCURRENCY=32

# Public search-engine dork pacing for LinkedIn/name/phone identity fan-outs.
FORGE_SEARCH_DORK_REQUEST_DELAY_SECONDS=0.25

# Direct public identity-provider lookup pacing for Gravatar/Instagram-style
# providers. This is delay/backoff only, not rate-limit bypass.
FORGE_IDENTITY_LOOKUP_REQUEST_DELAY_SECONDS=0.25
FORGE_IDENTITY_LOOKUP_RATE_LIMIT_BACKOFF_SECONDS=60.0
FORGE_IDENTITY_LOOKUP_MAX_RETRY_AFTER_SECONDS=300.0
FORGE_IDENTITY_LOOKUP_RATE_LIMIT_RETRIES=1
FORGE_IDENTITY_LOOKUP_MAX_WORKERS=1
# Optional proxy for supported identity lookups/subprocesses:
# Gravatar direct HTTP plus GHunt/Holehe/Maigret/Sherlock/WhatsMyName/theHarvester env routing.
# Example: FORGE_PROXY=socks5://127.0.0.1:9050
# FORGE_PROXY=

# Bootstrap installs external OSINT CLIs into per-tool venvs by default:
# Windows: %LOCALAPPDATA%\FORGE\osint-tools\<tool>-venv
# POSIX:   ~/.local/share/forge/osint-tools/<tool>-venv
# Keep GHunt and theHarvester separate because their httpx pins conflict.
# Use FORGE_<TOOL>_VENV only when overriding the default per-tool venv path.
# FORGE_INSTALL_OSINT_IN_PROJECT_VENV=1 restores the older shared-runtime mode
# but is not recommended unless you accept dependency conflicts.

# Optional GHunt isolation overrides.
# FORGE_GHUNT_VENV="C:\tools\ghunt\.venv"
# FORGE_GHUNT_COMMAND="C:\tools\ghunt\.venv\Scripts\python.exe -m ghunt"
# FORGE_GHUNT_BINARY="C:\tools\ghunt\.venv\Scripts\ghunt.exe"

# Optional theHarvester isolation overrides.
# FORGE_THEHARVESTER_VENV="C:\tools\theharvester\.venv"
# FORGE_THEHARVESTER_COMMAND="C:\tools\theharvester\.venv\Scripts\python.exe -m theHarvester"
# FORGE_THEHARVESTER_BINARY="C:\tools\theharvester\.venv\Scripts\theHarvester.exe"

# Optional Holehe isolation overrides.
# FORGE_HOLEHE_VENV="C:\tools\holehe\.venv"
# FORGE_HOLEHE_COMMAND="C:\tools\holehe\.venv\Scripts\python.exe -m holehe"
# FORGE_HOLEHE_BINARY="C:\tools\holehe\.venv\Scripts\holehe.exe"

# Optional username/social enumeration isolation overrides.
# FORGE_WHATSMYNAME_VENV="C:\tools\whatsmyname\.venv"
# FORGE_WHATSMYNAME_COMMAND="C:\tools\whatsmyname\.venv\Scripts\python.exe -m whatsmyname"
# FORGE_WHATSMYNAME_BINARY="C:\tools\whatsmyname\.venv\Scripts\whatsmyname.exe"
# FORGE_MAIGRET_VENV="C:\tools\maigret\.venv"
# FORGE_MAIGRET_COMMAND="C:\tools\maigret\.venv\Scripts\python.exe -m maigret"
# FORGE_MAIGRET_BINARY="C:\tools\maigret\.venv\Scripts\maigret.exe"
# FORGE_SHERLOCK_VENV="C:\tools\sherlock\.venv"
# FORGE_SHERLOCK_COMMAND="C:\tools\sherlock\.venv\Scripts\python.exe -m sherlock"
# FORGE_SHERLOCK_BINARY="C:\tools\sherlock\.venv\Scripts\sherlock.exe"

# Credential/cloud-provider validation pacing. This is delay/backoff only,
# not proxy rotation or rate-limit bypass.
FORGE_KEY_VALIDATION_REQUEST_DELAY_SECONDS=0.25
FORGE_KEY_VALIDATION_RATE_LIMIT_BACKOFF_SECONDS=60.0
FORGE_KEY_VALIDATION_MAX_RETRY_AFTER_SECONDS=300.0
FORGE_KEY_VALIDATION_RATE_LIMIT_RETRIES=1
FORGE_VALIDATION_MAX_WORKERS=1
FORGE_ARTIFACT_PROCESSOR_MAX_WORKERS=4

# Optional GitLab token for keyscan on GitLab-hosted repos
FORGE_GITLAB_TOKEN=

# Paid tier ($3.50/mo) unlocks HIBP per-email lookup.
# Leave empty for free domain-level tier.
FORGE_HIBP_API_KEY=

# Paid; DeHashed API. Leave empty to skip that scanner.
FORGE_DEHASHED_API_KEY=
FORGE_DEHASHED_EMAIL=

# Empty = auto-discovery mode (module derives ref from discovered refs)
FORGE_SUPABASE_ANON_KEY=
FORGE_FIREBASE_API_KEY=

# For the OPSEC gate on `keyscan` when live-validation is enabled:
#   Set to socks5://127.0.0.1:9050 to force validation through Tor.
FORGE_VALIDATION_PROXY=


# ═════════════════════════════════════════════════════════════════
#  Section 5: Cloud OSINT (optional; auto-detected via `prereq_detection`)
# ═════════════════════════════════════════════════════════════════

# If AWS_PROFILE or AWS_ACCESS_KEY_ID is set, `cloud aws` gets offered
# at the end of every kill-chain.
# AWS_PROFILE=default

# If FORGE_AZURE_SUBSCRIPTION_ID or AZURE_TENANT_ID is set, `cloud
# azure` gets offered.
# FORGE_AZURE_SUBSCRIPTION_ID=

# ═════════════════════════════════════════════════════════════════
#  End of file
# ═════════════════════════════════════════════════════════════════
